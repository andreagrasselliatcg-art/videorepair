#!/bin/bash
# Aggiorna il menu Servizi del Finder per l'utente che installa
USER_NAME="$(stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
  sudo -u "$USER_NAME" /System/Library/CoreServices/pbs -update >/dev/null 2>&1 || true
fi
/System/Library/CoreServices/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/VideoRepair.app >/dev/null 2>&1 || true
exit 0
